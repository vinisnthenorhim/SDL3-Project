#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Alpha
{
    float alpha[1];
};

struct main0_out
{
    float4 outColor [[color(0)]];
};

struct main0_in
{
    float2 fragUV [[user(locn0)]];
    uint objectIndex [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], const device Alpha& _23 [[buffer(0)]], texture2d<float> tex [[texture(0)]], sampler texSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 color = tex.sample(texSmplr, in.fragUV);
    color.w *= _23.alpha[in.objectIndex];
    out.outColor = color;
    return out;
}

