static inline __attribute__((always_inline))
float4x4 translationMatrix(thread const float4& offset)
{
    return float4x4(float4(1.0, 0.0, 0.0, 0.0), float4(0.0, 1.0, 0.0, 0.0), float4(0.0, 0.0, 1.0, 0.0), float4(-offset.x, -offset.y, -offset.z, 1.0));
}

static inline __attribute__((always_inline))
float4x4 scaleMatrix(thread const float4& offset)
{
    return float4x4(float4(offset.x, 0.0, 0.0, 0.0), float4(0.0, offset.y, 0.0, 0.0), float4(0.0, 0.0, offset.z, 0.0), float4(0.0, 0.0, 0.0, 1.0));
}

static inline __attribute__((always_inline))
float4x4 rotationMatrix(thread const float4& rotation)
{
    float4x4 result = float4x4(float4(1.0, 0.0, 0.0, 0.0), float4(0.0, 1.0, 0.0, 0.0), float4(0.0, 0.0, 1.0, 0.0), float4(0.0, 0.0, 0.0, 1.0));
    if (rotation.x != 0.0)
    {
        float c = cos(rotation.x);
        float s = sin(rotation.x);
        result = result * float4x4(float4(1.0, 0.0, 0.0, 0.0), float4(0.0, c, s, 0.0), float4(0.0, -s, c, 0.0), float4(0.0, 0.0, 0.0, 1.0));
    }
    if (rotation.y != 0.0)
    {
        float c_1 = cos(rotation.y);
        float s_1 = sin(rotation.y);
        result = result * float4x4(float4(c_1, 0.0, -s_1, 0.0), float4(0.0, 1.0, 0.0, 0.0), float4(s_1, 0.0, c_1, 0.0), float4(0.0, 0.0, 0.0, 1.0));
    }
    if (rotation.z != 0.0)
    {
        float c_2 = cos(rotation.z);
        float s_2 = sin(rotation.z);
        result = result * float4x4(float4(c_2, s_2, 0.0, 0.0), float4(-s_2, c_2, 0.0, 0.0), float4(0.0, 0.0, 1.0, 0.0), float4(0.0, 0.0, 0.0, 1.0));
    }
    return result;
}

